#!/bin/bash
# Round 4 check on frnt201, one job (about 35 minutes on 16 CPUs):
#   1. build with no modules loaded, quick validity run
#   2. normal build, validity on demo1-3
#   3. copies per core: 1 (SMT=1), 2 (SMT=2), 2 sharing a frame buffer
#   4. the official run (120 s x 3) on each demo with the best setting
#
# Submit from inside the repo:
#   sbatch scripts/frnt201-round4.job
# The shared frame buffer is only a candidate in step 4 if you say so:
#   sbatch --export=ALL,FBSHARE_OK=1 scripts/frnt201-round4.job
#
# Results: round4-<jobid>.out and benchmarks/round4-frnt201-<time>.txt
#SBATCH --account=sg6079000
#SBATCH --nodelist=frnt201
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=16
#SBATCH --mem-per-cpu=1G
#SBATCH --time=00:59:00
#SBATCH --output=round4-%j.out

cd "${SLURM_SUBMIT_DIR:-$PWD}" || exit 1

SECS=${SECS:-30}          # length of each tuning run
REPS=${REPS:-3}           # repeats per setting in step 3
FINAL=${FINAL:-120}       # length of the official runs in step 4
FBSHARE_OK=${FBSHARE_OK:-0}
MARGIN=${MARGIN:-8}       # SMT=2 must beat SMT=1 by this many percent

mkdir -p benchmarks
OUT=benchmarks/round4-$(hostname -s)-$(date +%Y%m%d-%H%M).txt
say() { echo "$@" | tee -a "$OUT"; }

say "host: $(hostname)  cpus: $(nproc) ($(awk '/^Cpus_allowed_list/ { print $2 }' /proc/self/status))"
say "load: $(uptime | sed 's/.*load average: //')   date: $(date)"

# --- 1. build with no modules loaded ---------------------------------
if type module > /dev/null 2>&1; then
    say ""
    say "== 1. build with no modules loaded =="
    (
        module purge > /dev/null 2>&1
        say "compiler: $(gcc --version 2>&1 | head -1)"
        make -C doom clean > /dev/null 2>&1
        if make -C doom -j"$(nproc)" > /dev/null 2>&1; then
            say "build OK"
            scripts/score.sh demo1 15 1 | grep "run 1" | tee -a "$OUT"
            cat results/run1/*.log 2> /dev/null | grep DGVALID | sort | uniq -c | tee -a "$OUT"
        else
            say "BUILD FAILED with no modules loaded"
        fi
    )
    module load gcc > /dev/null 2>&1
fi

# --- 2. normal build, validity ---------------------------------------
say ""
say "== 2. normal build =="
say "compiler: $(gcc --version | head -1)"
make -C doom clean > /dev/null 2>&1
if ! make -C doom -j"$(nproc)" > /dev/null 2>&1; then
    say "BUILD FAILED"
    exit 1
fi
say "build OK"
bad=0
for d in demo1 demo2 demo3; do
    line=$(scripts/score.sh "$d" 20 1 | grep "run 1")
    say "$d $line"
    cat results/run1/*.log 2> /dev/null | grep DGVALID | sort | uniq -c | tee -a "$OUT"
    case $line in *" 0 invalid"*) ;; *) bad=1 ;; esac
done
say "Expected: 0 invalid; matched=7115 (or 7116) / 7088 / 6041."
if [ "$bad" = 1 ]; then
    say "INVALID DEMOS: stop here and do not submit this build."
    exit 1
fi

# --- 3. copies per core ----------------------------------------------
# sweep.sh prints one summary line per setting with its median demos/s.
rate() {    # rate <label> <file>: median demos/s of that setting
    awk -v l="$1" 'index($0, l) == 1 {
        for (i = 2; i <= NF; i++) if ($i == "demos/s") { print $(i - 1); exit } }' "$2"
}
invalid() { # invalid <label> <file>: invalid demos of that setting
    awk -v l="$1" 'index($0, l) == 1 && /demos\/s/ { print $NF; exit }' "$2"
}

L1="1 per core (SMT=1)"
L2="2 per core (SMT=2)"
L3="2 per core, shared fb"
r1=0 r2=0 r3=0 inv1=0 inv2=0 inv3=0
for d in demo1 demo3; do
    tmp=$(mktemp)
    OUT=$tmp SECS=$SECS REPS=$REPS scripts/sweep.sh ht "$d" > /dev/null 2>&1
    cat "$tmp" >> "$OUT"
    r1=$(awk -v a="$r1" -v b="$(rate "$L1" "$tmp")" 'BEGIN { print a + b }')
    r2=$(awk -v a="$r2" -v b="$(rate "$L2" "$tmp")" 'BEGIN { print a + b }')
    r3=$(awk -v a="$r3" -v b="$(rate "$L3" "$tmp")" 'BEGIN { print a + b }')
    v=$(invalid "$L1" "$tmp"); inv1=$((inv1 + ${v:-0}))
    v=$(invalid "$L2" "$tmp"); inv2=$((inv2 + ${v:-0}))
    v=$(invalid "$L3" "$tmp"); inv3=$((inv3 + ${v:-0}))
    rm -f "$tmp"
done

say ""
say "== 3. copies per core: demos/s on demo1 + demo3 (median of $REPS) =="
say "  SMT=1            $r1   (invalid $inv1)"
say "  SMT=2            $r2   (invalid $inv2)"
say "  SMT=2 FBSHARE=1  $r3   (invalid $inv3)"

# Two copies per core with private frame buffers need the most cache, and
# a 16-CPU job has far more L3 per copy than the full node will. So that
# setting has to win clearly here to be chosen.
pick=$(awk -v r1="$r1" -v r2="$r2" -v r3="$r3" -v i1="$inv1" -v i2="$inv2" -v i3="$inv3" \
           -v fb="$FBSHARE_OK" -v m="$MARGIN" 'BEGIN {
    if (r1 + r2 + r3 == 0) { print "none"; exit }
    if (i1 > 0) r1 = 0; if (i2 > 0) r2 = 0; if (i3 > 0 || fb != 1) r3 = 0
    best = "1 0"; rate = r1
    if (r2 > r1 * (1 + m / 100)) { best = "2 0"; rate = r2 }
    if (r3 > rate && r3 > r1 * 1.02) best = "2 1"
    print best }')
if [ "$pick" = none ]; then
    say "No numbers from step 3; step 4 uses the defaults in scripts/run.sh."
    pick="$(sed -n 's/^SMT=\${SMT:-\([0-9]\)}.*/\1/p' scripts/run.sh) $(sed -n 's/^FBSHARE=\${FBSHARE:-\([0-9]\)}.*/\1/p' scripts/run.sh)"
fi
SMT_BEST=${pick% *}
FB_BEST=${pick#* }
say "Chosen for step 4: SMT=$SMT_BEST FBSHARE=$FB_BEST  (FBSHARE_OK=$FBSHARE_OK)"

# --- 4. official runs ------------------------------------------------
say ""
say "== 4. scripts/score.sh <demo> $FINAL 3 with SMT=$SMT_BEST FBSHARE=$FB_BEST =="
for d in demo1 demo2 demo3; do
    SMT=$SMT_BEST FBSHARE=$FB_BEST scripts/score.sh "$d" "$FINAL" 3 | tee -a "$OUT"
    cat results/run3/*.log 2> /dev/null | grep DGVALID | sort | uniq -c | tee -a "$OUT"
done

say ""
say "To make this the default, the two lines near the top of scripts/run.sh become:"
say "  SMT=\${SMT:-$SMT_BEST}"
say "  FBSHARE=\${FBSHARE:-$FB_BEST}"
say "Saved to $OUT"
